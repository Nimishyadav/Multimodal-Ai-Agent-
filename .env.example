# Copy to .env; replace the placeholder locally, never in chat.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
# Optional: Tavily free-plan web search.
TAVILY_API_KEY=your_tavily_api_key_here

# Main provider stays Groq; configured alternatives are tried automatically on failure.
LLM_PROVIDER=groq
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Separate Excel provider. Only free models are accepted.
OPENROUTER_API_KEY=your_openrouter_api_key_here
EXCEL_MODEL=openrouter/free

# Optional flight/hotel listing search; separate from Tavily.
SERPAPI_API_KEY=your_serpapi_api_key_here

# Image understanding reuses OPENROUTER_API_KEY; free models only.
VISION_MODEL=google/gemma-4-26b-a4b-it:free

# Text fallback uses existing OpenRouter key; free models only.
CHAT_BACKUP_MODEL=openrouter/free

# Separate image-capable model; reuses the existing Groq key.
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Optional isolated MinerU + official RAG-Anything backend.
DOCUMENT_RAG_BACKEND=raganything
MINERU_DEVICE=cpu
RAG_MAX_MODEL_CALLS=16
# Optional interpreter override; defaults to .venv-rag/Scripts/python.exe on Windows.
# RAG_PYTHON=

# Optional MinerU Cloud token. Uploads also require the explicit UI checkbox.
MINERU_API_TOKEN=

# Maximum wait per hybrid query worker; indexing has a separate budget.
RAG_QUERY_TIMEOUT_SECONDS=40

# cloud moves parser/embedding AI inference to APIs; no CPU model fallback.
# Local graph/vector storage and lightweight Python tools remain on this PC.
RAG_PROCESSING_MODE=cloud
RAG_EMBEDDING_PROVIDER=gemini
# For cloud mode, set both values to cloud and gemini respectively.

# Official hybrid RAG-Anything. LightRAG graph is internal; no Ollama.

# Enable only after approving document uploads to MinerU and text embeddings to Google.
RAG_CLOUD_UPLOAD_APPROVED=false
